/* =========================================================
   MONMOUTH SIXTH FORM REVISION APP
   MAIN STYLESHEET
========================================================= */

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  padding: 0;
  min-height: 100%;
  width: 100%;
}

body {
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  background: #f5f7fb;
  color: #172033;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: none;
}

.app {
  min-height: 100vh;
  background: #f5f7fb;
}


/* =========================================================
   LOGIN / SIGNUP
========================================================= */

.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
  background:
    radial-gradient(
      circle at top left,
      #eef2ff 0,
      transparent 35%
    ),
    #f5f7fb;
}

.auth-card {
  width: 100%;
  max-width: 460px;
  padding: 42px;
  border: 1px solid #e4e8f0;
  border-radius: 24px;
  background: white;
  box-shadow:
    0 25px 70px rgba(15, 23, 42, 0.08);
}

.auth-logo {
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  border-radius: 15px;
  background: #334ed8;
  color: white;
  font-size: 22px;
  font-weight: 800;
}

.auth-card h1 {
  margin: 0;
  color: #111827;
  font-size: 29px;
}

.auth-card > p {
  margin: 8px 0 28px;
  color: #64748b;
  line-height: 1.6;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 17px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.form-group label {
  color: #334155;
  font-size: 12px;
  font-weight: 700;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #dbe1ea;
  border-radius: 11px;
  outline: none;
  background: white;
  color: #172033;
  transition: 0.2s ease;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #6579e6;
  box-shadow:
    0 0 0 3px rgba(82, 105, 225, 0.1);
}

.auth-button {
  width: 100%;
  margin-top: 5px;
  padding: 13px;
  border-radius: 11px;
  background: #334ed8;
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.auth-button:hover {
  background: #2942c0;
  transform: translateY(-1px);
}

.auth-switch {
  margin-top: 22px;
  text-align: center;
  color: #64748b;
  font-size: 13px;
}

.auth-switch button {
  padding: 0;
  background: none;
  color: #334ed8;
  font-weight: 700;
  cursor: pointer;
}

.auth-error {
  margin-bottom: 15px;
  padding: 11px 13px;
  border-radius: 10px;
  background: #fef2f2;
  color: #dc2626;
  font-size: 13px;
}


/* =========================================================
   TOP BAR
========================================================= */

.topbar {
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  border-bottom: 1px solid #e4e8f0;
  background: white;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 43px;
  height: 43px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13px;
  background: #334ed8;
  color: white;
  font-size: 19px;
  font-weight: 800;
  box-shadow:
    0 7px 18px rgba(51, 78, 216, 0.2);
}

.brand h1 {
  margin: 0;
  color: #111827;
  font-size: 16px;
  font-weight: 750;
}

.brand p {
  margin: 2px 0 0;
  color: #94a3b8;
  font-size: 11px;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.profile-avatar {
  width: 39px;
  height: 39px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef2ff;
  color: #334ed8;
  font-weight: 800;
}

.profile strong {
  display: block;
  color: #1e293b;
  font-size: 13px;
}

.profile span {
  display: block;
  margin-top: 2px;
  color: #94a3b8;
  font-size: 11px;
}


/* =========================================================
   MAIN LAYOUT
========================================================= */

.layout {
  display: flex;
  min-height: calc(100vh - 78px);
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
  width: 230px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 22px 14px;
  border-right: 1px solid #e4e8f0;
  background: white;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 13px;
  border-radius: 11px;
  background: transparent;
  color: #64748b;
  text-align: left;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.nav-item:hover {
  background: #f7f8ff;
  color: #334ed8;
}

.nav-item.active {
  background: #eef2ff;
  color: #334ed8;
}

.nav-item.settings {
  margin-top: 20px;
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.main-content {
  flex: 1;
  min-width: 0;
  padding: 35px;
  overflow-x: hidden;
}

.welcome-section {
  margin-bottom: 30px;
}

.eyebrow,
.card-eyebrow {
  margin: 0 0 5px;
  color: #6476d9;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.welcome-section h2 {
  margin: 0;
  color: #111827;
  font-size: 30px;
  line-height: 1.2;
}

.welcome-section > p:last-child {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 14px;
}


/* =========================================================
   EMPTY PAGES
========================================================= */

.empty-page {
  min-height: 350px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: white;
  text-align: center;
  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.04);
}

.empty-icon {
  margin-bottom: 15px;
  font-size: 45px;
}

.empty-page h3 {
  margin: 0;
  color: #111827;
  font-size: 21px;
}

.empty-page p {
  margin: 7px 0 0;
  color: #64748b;
}


/* =========================================================
   HOME
========================================================= */

.home-page {
  width: 100%;
}

.home-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.dashboard-card {
  padding: 24px;
  border: 1px solid #e4e8f0;
  border-radius: 19px;
  background: white;
  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.04);
}

.dashboard-card.large {
  grid-column: span 2;
}

.dashboard-card h3 {
  margin: 0;
  color: #111827;
  font-size: 18px;
}

.dashboard-card p {
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}

.quick-actions {
  display: grid;
  grid-template-columns:
    repeat(3, 1fr);
  gap: 12px;
  margin-top: 20px;
}

.quick-action {
  padding: 17px;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  background: #fafbff;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.quick-action:hover {
  border-color: #c7d2fe;
  background: #f7f8ff;
  transform: translateY(-2px);
}

.quick-action-icon {
  margin-bottom: 9px;
  font-size: 22px;
}

.quick-action strong {
  display: block;
  color: #1e293b;
  font-size: 13px;
}

.quick-action span {
  display: block;
  margin-top: 3px;
  color: #94a3b8;
  font-size: 11px;
}


/* =========================================================
   REVISION
========================================================= */

.revision-page {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
}

.revision-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 38px;
}

.revision-header h2 {
  margin: 5px 0 8px;
  color: #111827;
  font-size: 34px;
}

.revision-description {
  margin: 0;
  max-width: 650px;
  color: #64748b;
  font-size: 15px;
  line-height: 1.6;
}

.manage-subjects-button {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 17px;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: white;
  color: #334155;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
  transition: 0.2s ease;
}

.manage-subjects-button:hover {
  border-color: #c7d2fe;
  background: #f8faff;
  color: #334ed8;
  transform: translateY(-2px);
}

.revision-section-heading {
  margin-bottom: 18px;
}

.revision-section-heading h3 {
  margin: 0;
  color: #111827;
  font-size: 21px;
}

.revision-section-heading p {
  margin: 5px 0 0;
  color: #94a3b8;
  font-size: 13px;
}

.revision-subject-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.revision-subject-card {
  position: relative;
  width: 100%;
  min-height: 275px;
  padding: 24px;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: white;
  color: inherit;
  text-align: left;
  cursor: pointer;
  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.045);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.revision-subject-card:hover {
  transform: translateY(-4px);
  border-color: #c7d2fe;
  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.09);
}

.revision-subject-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.revision-subject-icon {
  width: 58px;
  height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #eef2ff;
  font-size: 28px;
}

.revision-subject-arrow {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8fafc;
  color: #64748b;
  font-size: 19px;
  transition: 0.2s ease;
}

.revision-subject-card:hover
.revision-subject-arrow {
  background: #eef2ff;
  color: #334ed8;
  transform: translateX(3px);
}

.revision-subject-content {
  margin-top: 21px;
}

.revision-subject-content h3 {
  margin: 0 0 7px;
  color: #111827;
  font-size: 20px;
}

.revision-subject-content p {
  margin: 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}

.subject-resource-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 18px;
}

.subject-resource-preview span {
  padding: 6px 9px;
  border-radius: 8px;
  background: #f8fafc;
  color: #64748b;
  font-size: 10px;
  font-weight: 650;
}

.open-subject {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20px;
  padding-top: 15px;
  border-top: 1px solid #f1f5f9;
  color: #334ed8;
  font-size: 12px;
  font-weight: 750;
}

.revision-information {
  display: flex;
  align-items: center;
  gap: 17px;
  margin-top: 25px;
  padding: 20px 23px;
  border: 1px solid #e2e8f0;
  border-radius: 17px;
  background: white;
}

.revision-information-icon {
  width: 47px;
  height: 47px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13px;
  background: #eef2ff;
  font-size: 22px;
}

.revision-information strong {
  color: #111827;
  font-size: 14px;
}

.revision-information p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.5;
}

.no-subjects {
  padding: 65px 30px;
  border: 1px dashed #cbd5e1;
  border-radius: 20px;
  background: white;
  text-align: center;
}

.no-subjects-icon {
  font-size: 45px;
}

.no-subjects h3 {
  margin: 15px 0 8px;
  color: #111827;
}

.no-subjects p {
  margin: 0 auto 20px;
  max-width: 450px;
  color: #64748b;
  line-height: 1.6;
}

.primary-card-button {
  padding: 11px 17px;
  border-radius: 10px;
  background: #334ed8;
  color: white;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
  transition: 0.2s ease;
}

.primary-card-button:hover {
  transform: translateY(-2px);
  background: #2942c0;
}

.revision-loading {
  min-height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  font-size: 42px;
}

.revision-loading h2 {
  margin: 18px 0 6px;
}

.revision-loading p {
  margin: 0;
  color: #64748b;
}

.revision-error {
  min-height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.revision-error-icon {
  font-size: 42px;
}

.revision-error h2 {
  margin: 15px 0 7px;
}

.revision-error p {
  margin: 0 0 20px;
  color: #64748b;
}


/* =========================================================
   SUBJECT SELECTION
========================================================= */

.subject-selection-page {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

.subject-selection-header {
  margin-bottom: 25px;
}

.subject-selection-header h2 {
  margin: 0;
  color: #111827;
  font-size: 28px;
}

.subject-selection-header p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 14px;
}

.subject-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 13px;
}

.subject-option {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 15px;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: white;
  cursor: pointer;
  transition: 0.2s ease;
}

.subject-option:hover {
  border-color: #c7d2fe;
  transform: translateY(-2px);
}

.subject-option.selected {
  border-color: #526fe4;
  background: #f5f7ff;
}

.subject-option-icon {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 11px;
  background: #eef2ff;
  font-size: 20px;
}

.subject-option h3 {
  margin: 0;
  color: #1e293b;
  font-size: 13px;
}

.subject-option p {
  margin: 3px 0 0;
  color: #94a3b8;
  font-size: 10px;
}


/* =========================================================
   TIMETABLE
========================================================= */

.timetable-page {
  width: 100%;
  overflow-x: auto;
}

.timetable-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
}

.week-switcher {
  display: flex;
  gap: 7px;
}

.week-button {
  padding: 9px 15px;
  border: 1px solid #e2e8f0;
  border-radius: 9px;
  background: white;
  color: #64748b;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
}

.week-button.active {
  border-color: #334ed8;
  background: #334ed8;
  color: white;
}

.timetable-grid {
  min-width: 900px;
  display: grid;
  grid-template-columns:
    95px repeat(5, 1fr);
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  background: white;
}

.timetable-header {
  padding: 14px 10px;
  border-right: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
  background: #f8fafc;
  text-align: center;
  color: #475569;
  font-size: 11px;
  font-weight: 750;
}

.timetable-cell {
  min-height: 72px;
  padding: 9px;
  border-right: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
  background: white;
}

.timetable-time {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
  text-align: center;
}

.timetable-lesson {
  min-height: 55px;
  padding: 9px;
  border-radius: 9px;
  background: #eef2ff;
  color: #334ed8;
}

.timetable-lesson strong {
  display: block;
  font-size: 11px;
}

.timetable-lesson span {
  display: block;
  margin-top: 3px;
  font-size: 9px;
  opacity: 0.8;
}

.timetable-break {
  background: #f8fafc;
  color: #94a3b8;
  text-align: center;
  font-size: 10px;
}


/* =========================================================
   GENERAL CARDS
========================================================= */

.card {
  padding: 22px;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  background: white;
  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.04);
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 1000px) {

  .subject-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .home-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-card.large {
    grid-column: span 1;
  }

  .quick-actions {
    grid-template-columns: 1fr;
  }

  .revision-subject-grid {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 800px) {

  .topbar {
    padding: 0 18px;
  }

  .sidebar {
    width: 190px;
  }

  .main-content {
    padding: 25px;
  }

  .revision-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .manage-subjects-button {
    width: 100%;
    justify-content: center;
  }

}

@media (max-width: 650px) {

  .topbar {
    height: 70px;
  }

  .brand h1 {
    font-size: 14px;
  }

  .profile {
    display: none;
  }

  .layout {
    min-height: calc(100vh - 70px);
  }

  .sidebar {
    width: 68px;
    padding: 15px 7px;
  }

  .nav-item {
    justify-content: center;
    padding: 12px 5px;
  }

  .nav-item span {
    display: none;
  }

  .main-content {
    padding: 20px 15px;
  }

  .welcome-section h2 {
    font-size: 25px;
  }

  .revision-header h2 {
    font-size: 28px;
  }

  .revision-subject-card {
    min-height: auto;
  }

  .subject-grid {
    grid-template-columns: 1fr;
  }

  .auth-card {
    padding: 30px 22px;
  }

}/* =========================================
   REVISION HUB
========================================= */

.revision-page {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
}

.revision-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 38px;
}

.revision-header h2 {
  margin: 5px 0 8px;
  font-size: 34px;
  color: #0f172a;
}

.revision-description {
  margin: 0;
  max-width: 650px;
  color: #64748b;
  font-size: 15px;
  line-height: 1.6;
}

.manage-subjects-button {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 17px;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: white;
  color: #334155;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.manage-subjects-button:hover {
  border-color: #c7d2fe;
  background: #f8faff;
  color: #334ed8;
  transform: translateY(-2px);
}


/* SECTION HEADING */

.revision-section-heading {
  margin-bottom: 18px;
}

.revision-section-heading h3 {
  margin: 0;
  font-size: 21px;
  color: #0f172a;
}

.revision-section-heading p {
  margin: 5px 0 0;
  color: #94a3b8;
  font-size: 13px;
}


/* SUBJECT GRID */

.revision-subject-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.revision-subject-card {
  position: relative;
  width: 100%;
  min-height: 275px;
  padding: 24px;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: white;
  text-align: left;
  cursor: pointer;
  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.045);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.revision-subject-card:hover {
  transform: translateY(-4px);
  border-color: #c7d2fe;
  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.09);
}


/* ICON */

.revision-subject-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.revision-subject-icon {
  width: 58px;
  height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #eef2ff;
  font-size: 28px;
}

.revision-subject-arrow {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8fafc;
  color: #64748b;
  font-size: 19px;
  transition: 0.2s ease;
}

.revision-subject-card:hover
.revision-subject-arrow {
  background: #eef2ff;
  color: #334ed8;
  transform: translateX(3px);
}


/* SUBJECT CONTENT */

.revision-subject-content {
  margin-top: 21px;
}

.revision-subject-content h3 {
  margin: 0 0 7px;
  color: #0f172a;
  font-size: 20px;
}

.revision-subject-content p {
  margin: 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}


/* RESOURCE PREVIEW */

.subject-resource-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 18px;
}

.subject-resource-preview span {
  padding: 6px 9px;
  border-radius: 8px;
  background: #f8fafc;
  color: #64748b;
  font-size: 10px;
  font-weight: 600;
}


/* OPEN SUBJECT */

.open-subject {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20px;
  padding-top: 15px;
  border-top: 1px solid #f1f5f9;
  color: #334ed8;
  font-size: 12px;
  font-weight: 700;
}


/* INFORMATION CARD */

.revision-information {
  display: flex;
  align-items: center;
  gap: 17px;
  margin-top: 25px;
  padding: 20px 23px;
  border: 1px solid #e2e8f0;
  border-radius: 17px;
  background: white;
}

.revision-information-icon {
  width: 47px;
  height: 47px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13px;
  background: #eef2ff;
  font-size: 22px;
}

.revision-information strong {
  color: #0f172a;
  font-size: 14px;
}

.revision-information p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.5;
}


/* NO SUBJECTS */

.no-subjects {
  padding: 65px 30px;
  border: 1px dashed #cbd5e1;
  border-radius: 20px;
  background: white;
  text-align: center;
}

.no-subjects-icon {
  font-size: 45px;
}

.no-subjects h3 {
  margin: 15px 0 8px;
  color: #0f172a;
}

.no-subjects p {
  margin: 0 auto 20px;
  max-width: 450px;
  color: #64748b;
  line-height: 1.6;
}

.primary-card-button {
  padding: 11px 17px;
  border: none;
  border-radius: 10px;
  background: #334ed8;
  color: white;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.primary-card-button:hover {
  transform: translateY(-2px);
  opacity: 0.92;
}


/* LOADING */

.revision-loading {
  min-height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  font-size: 42px;
}

.revision-loading h2 {
  margin: 18px 0 6px;
  color: #0f172a;
}

.revision-loading p {
  margin: 0;
  color: #64748b;
}


/* ERROR */

.revision-error {
  min-height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.revision-error-icon {
  font-size: 42px;
}

.revision-error h2 {
  margin: 15px 0 7px;
}

.revision-error p {
  margin: 0 0 20px;
  color: #64748b;
}


/* MOBILE */

@media (max-width: 900px) {

  .revision-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .manage-subjects-button {
    width: 100%;
    justify-content: center;
  }

  .revision-subject-grid {
    grid-template-columns: 1fr;
  }

}
